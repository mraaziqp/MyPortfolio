# Copy to .env.local for `npm run dev`. Production values live in Vercel → Settings → Environment Variables.
# Generate keys with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"

# Full access for the Jarvis assistant / dashboard manager (x-jarvis-key or Authorization: Bearer).
JARVIS_API_KEY=""
# Sync key for Emeron / CV tooling: POST /api/sync-cv and GET /api/telemetry only.
PORTFOLIO_API_KEY=""

# Postgres (Neon). Without it the API keeps data in memory and /api/health says storage: "memory".
DATABASE_URL=""

# Contact-form email delivery via Resend. RESEND_FROM must use a domain verified in Resend;
# the default onboarding@resend.dev only delivers to the Resend account owner's address.
RESEND_API_KEY=""
RESEND_FROM="Portfolio <portfolio@arpcloudsolutions.co.za>"
NOTIFY_EMAIL=""

# Optional Jarvis alerts: either a full webhook URL, or base URL + jb_live_sk_ key.
JARVIS_WEBHOOK_URL=""
JARVIS_PUBLIC_URL=""
JARVIS_WEBHOOK_KEY=""
JARVIS_USER_ID=""

SITE_URL="https://portfolio.arpcloudsolutions.co.za"
